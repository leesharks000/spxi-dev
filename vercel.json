{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!\\.well-known/).*)",
      "has": [
        {
          "type": "host",
          "value": "spxi.dev"
        }
      ],
      "destination": "https://www.spxi.dev/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/.well-known/mcp-registry-auth",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
